# NESF Core: Supabase Configuration
# Database connection to your Supabase PostgreSQL instance

PORT=4000
NODE_ENV=production

# Supabase PostgreSQL Database Connection
# Using: mixbtfnjdzmfbctkxnwk.supabase.co
# User: postgres
# Password: NEsports@#2026
DATABASE_URL=postgres://postgres:NEsports%40%232026@mixbtfnjdzmfbctkxnwk.supabase.co:5432/postgres?sslmode=require

# Alternative: Connection pooling (recommended for serverless/Vercel)
# Uncomment this line for production deployment:
# DATABASE_URL=postgres://postgres:NEsports%40%232026@mixbtfnjdzmfbctkxnwk.supabase.co:6543/postgres?sslmode=require

# JWT Secret (generate a new one for production)
# Run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-generated-secret-here-min-32-chars

# Token Configuration
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_DAYS=30

# CORS Origins (update with your Vercel deployment URL)
CORS_ORIGINS=https://app.nesportsfoundation.in,http://localhost:3000,http://localhost:4000

# File Storage
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000

# Seed Data (first time setup)
SEED_ADMIN_EMAIL=biki@nesportsfoundation.in
SEED_ADMIN_PASSWORD=ChangeMe@123

# SSL Configuration
DB_SSL=true
