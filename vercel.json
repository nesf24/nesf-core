{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/health", "destination": "/health" },
    { "source": "/(.*\\.apk)$", "destination": "/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/health", "dest": "/health" },
    { "src": "/public/(.*)", "dest": "/public/$1" }
  ],
  "env": {
    "API_BASE": "https://app.nesportsfoundation.in"
  }
}
