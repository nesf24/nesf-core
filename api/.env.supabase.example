# NESF Core: Supabase Configuration
# Copy this to .env and fill in your Supabase credentials

PORT=4000
NODE_ENV=production

# Supabase PostgreSQL Database
# Get these from: https://app.supabase.com → Settings → Database
DATABASE_URL=postgres://postgres:[PASSWORD]@[PROJECT].supabase.co:5432/postgres?sslmode=require

# Alternative: Use connection pooling (recommended for serverless)
# DATABASE_URL=postgres://postgres:[PASSWORD]@[PROJECT].supabase.co:6543/postgres?sslmode=require

# JWT Secret (generate a new one, at least 32 chars)
# Run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-generated-secret-here

# Token TTL
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_DAYS=30

# CORS (allow your Vercel app)
CORS_ORIGINS=https://nesf-core-4rqwq0t6e-nesports.vercel.app,http://localhost:3000

# File Storage (Supabase or local)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000

# Seed Data (first time setup)
SEED_ADMIN_EMAIL=biki@nesportsfoundation.in
SEED_ADMIN_PASSWORD=ChangeMe@123

# SSL Mode
DB_SSL=true
