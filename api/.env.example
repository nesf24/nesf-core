# ---- NESF Core API ----
PORT=4000
NODE_ENV=development

# Local / TCP Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nesf_core
DB_SSL=false

# Cloud Run + Cloud SQL (set these instead of DATABASE_URL in production)
# INSTANCE_UNIX_SOCKET=/cloudsql/PROJECT:REGION:INSTANCE
# DB_USER=nesf_core
# DB_PASSWORD=
# DB_NAME=nesf_core

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_DAYS=30

# Comma-separated origins allowed to call the API (Flutter web build + admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,https://app.nesportsfoundation.in

# Uploads: "local" writes to ./uploads, "gcs" uses a Cloud Storage bucket.
# Nothing uploaded is public — files are read back through the authenticated
# /api/media endpoint, so the GCS bucket needs no allUsers binding.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# GCS_BUCKET=nesf-core-uploads

# Seed admin created by `npm run seed`
SEED_ADMIN_EMAIL=biki@nesportsfoundation.in
SEED_ADMIN_PASSWORD=ChangeMe@123

# One-time import of staff from the existing thenesports-api database
# LEGACY_DATABASE_URL=postgres://user:pass@host:5432/thenesports
